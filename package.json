      },
      {
        "id": "gherkinFeatureKeyword",
        "description": "Gherkin feature keyword",
        "superType": "keyword"
      },
      {
        "id": "gherkinFeatureTitle",
        "description": "Gherkin feature title",
        "superType": "string"
      },
      {
        "id": "gherkinScenarioKeyword",
        "description": "Gherkin scenario keyword",
        "superType": "keyword"
      },
      {
        "id": "gherkinScenarioTitle",
        "description": "Gherkin scenario title",
        "superType": "string"
      },
      {
        "id": "gherkinStepKeyword",
        "description": "Gherkin step keyword",
        "superType": "keyword"
      },
      {
        "id": "gherkinString",
