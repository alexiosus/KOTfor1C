        {
          "command": "kotTestToolkit.trackScenarioRunByFeatureLog",
          "when": "editorTextFocus && resourceExtname == .feature",
          "group": "00_navigation@1"
        },
        {
          "command": "kotTestToolkit.switchTrackedScenarioRunForFeature",
          "when": "editorTextFocus && resourceExtname == .feature",
          "group": "00_navigation@2"
        },
        {
          "command": "kotTestToolkit.stopTrackedScenarioRunForFeature",
          "when": "editorTextFocus && resourceExtname == .feature",
          "group": "00_navigation@3"
        },
