    "semanticTokenScopes": [
      {
        "language": "yaml",
        "scopes": {
          "gherkinComment": [
            "comment.line.number-sign"
          ],
          "gherkinFeatureKeyword": [
            "keyword.language.gherkin.feature"
          ],
          "gherkinFeatureTitle": [
            "string.language.gherkin.feature.title"
          ],
          "gherkinScenarioKeyword": [
            "keyword.language.gherkin.feature.scenario"
          ],
          "gherkinScenarioTitle": [
            "string.language.gherkin.scenario.title.title"
          ],
          "gherkinStepKeyword": [
            "keyword.language.gherkin.feature.step"
          ],
          "gherkinString": [
            "string.quoted.double",
            "string.quoted.single"
          ],
          "gherkinTag": [
            "entity.name.type.class.tsx"
          ],
          "gherkinPlaceholder": [
            "variable.other"
          ],
          "gherkinBracketParameter": [
            "variable.parameter",
            "variable.other"
          ],
          "gherkinTable": [
            "keyword.control.cucumber.table"
          ]
        }
      }
    ],
