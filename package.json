      },
      {
        "id": "gherkinTag",
        "description": "Gherkin tag",
        "superType": "decorator"
      },
      {
        "id": "gherkinPlaceholder",
        "description": "Gherkin placeholder",
        "superType": "variable"
      },
      {
        "id": "gherkinBracketParameter",
        "description": "KOT bracket parameter",
