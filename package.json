        },
        {
          "command": "kotTestToolkit.changeNestedScenarioName",
          "when": "editorTextFocus && !editorReadonly && resourceExtname == .yaml && !kotTestToolkit.activeScenarioIsMain",
          "group": "00_editing@1"
        },
        {
          "command": "kotTestToolkit.changeNestedScenarioCode",
          "when": "editorTextFocus && !editorReadonly && resourceExtname == .yaml && !kotTestToolkit.activeScenarioIsMain",
          "group": "00_editing@2"
        },
        {
          "command": "kotTestToolkit.checkAndFillNestedScenarios",
          "when": "editorTextFocus && resourceExtname == .yaml",
