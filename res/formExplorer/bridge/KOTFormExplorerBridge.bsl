&НаКлиенте
Функция KOTFEBridge_ЕстьЗапросОбновления()
	Попытка
		ФС = Новый Файл(KOTFEBridge_RequestFilePath);
		Возврат ФС.Существует();
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

&НаКлиенте
Функция KOTFEBridge_ПрочитатьКодЗапроса()
	Попытка
		ТД = Новый ТекстовыйДокумент;
		ТД.Прочитать(KOTFEBridge_RequestFilePath, КодировкаТекста.UTF8);
		Возврат НРег(СокрЛП(ТД.ПолучитьТекст()));
	Исключение
		Возврат "refresh";
	КонецПопытки;
КонецФункции

&НаКлиенте
Функция KOTFEBridge_ПолучитьПутьФайлаКонтекстаЗапроса()
	ПутьЗапроса = СокрЛП(Строка(KOTFEBridge_RequestFilePath));
	Если ПустаяСтрока(ПутьЗапроса) Тогда
		Возврат "";
	КонецЕсли;

	НормПуть = СтрЗаменить(ПутьЗапроса, "\", "/");
	ЧастиПути = СтрРазделить(НормПуть, "/");
	Если ЧастиПути = Неопределено Или ЧастиПути.Количество() = 0 Тогда
		Возврат "adapter-request-context.json";
	КонецЕсли;

	ЧастиПути.Удалить(ЧастиПути.ВГраница());
	Каталог = СтрСоединить(ЧастиПути, "/");
	Если ПустаяСтрока(Каталог) Тогда
		Возврат "adapter-request-context.json";
	КонецЕсли;

	Возврат Каталог + "/adapter-request-context.json";
КонецФункции

&НаКлиенте
Функция KOTFEBridge_ПрочитатьСуществующийСнимок()
	Если ПустаяСтрока(KOTFEBridge_SnapshotPath) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		ФайлСнимка = Новый Файл(KOTFEBridge_SnapshotPath);
		Если НЕ ФайлСнимка.Существует() Тогда
			Возврат Неопределено;
		КонецЕсли;
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	Попытка
		Чтение = Новый ЧтениеJSON;
		Чтение.ОткрытьФайл(KOTFEBridge_SnapshotPath);
		Снимок = ПрочитатьJSON(Чтение);
		Чтение.Закрыть();
		Возврат Снимок;
	Исключение
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

&НаКлиенте
Функция KOTFEBridge_СнимкиРавныБезGeneratedAt(НовыйСнимок, СтарыйСнимок)
	Если НовыйСнимок = Неопределено Или СтарыйСнимок = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	СтарыйGeneratedAtНовый = "";
	СтарыйGeneratedAtСтарый = "";
	Попытка СтарыйGeneratedAtНовый = СокрЛП(Строка(НовыйСнимок["generatedAt"])); Исключение КонецПопытки;
	Попытка СтарыйGeneratedAtСтарый = СокрЛП(Строка(СтарыйСнимок["generatedAt"])); Исключение КонецПопытки;

	Попытка НовыйСнимок.Вставить("generatedAt", ""); Исключение КонецПопытки;
	Попытка СтарыйСнимок.Вставить("generatedAt", ""); Исключение КонецПопытки;

	РезультатСравнения = Ложь;
	Попытка
		РезультатСравнения = KOTFEBridge_ПреобразоватьВJSONСтроку(НовыйСнимок) = KOTFEBridge_ПреобразоватьВJSONСтроку(СтарыйСнимок);
	Исключение
		РезультатСравнения = Ложь;
	КонецПопытки;
	Попытка НовыйСнимок.Вставить("generatedAt", СтарыйGeneratedAtНовый); Исключение КонецПопытки;
	Попытка СтарыйСнимок.Вставить("generatedAt", СтарыйGeneratedAtСтарый); Исключение КонецПопытки;
	Возврат РезультатСравнения;
КонецФункции

&НаКлиенте
Функция KOTFEBridge_ПреобразоватьВJSONСтроку(Данные)
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Данные);
	Возврат ЗаписьJSON.Закрыть();
КонецФункции

&НаКлиенте
Процедура KOTFEBridge_СохранитьРанееЗагруженныеТаблицы(НовыйСнимок, СтарыйСнимок)
	Если НовыйСнимок = Неопределено Или СтарыйСнимок = Неопределено Тогда
		Возврат;
	КонецЕсли;

	НовыеТаблицы = Неопределено;
	СтарыеТаблицы = Неопределено;
	Попытка НовыеТаблицы = НовыйСнимок["tables"]; Исключение КонецПопытки;
	Попытка СтарыеТаблицы = СтарыйСнимок["tables"]; Исключение КонецПопытки;
	Если НовыеТаблицы = Неопределено Или СтарыеТаблицы = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Для Каждого НоваяТаблица Из НовыеТаблицы Цикл
		НовДанныеТаблицы = Неопределено;
		Попытка НовДанныеТаблицы = НоваяТаблица["tableData"]; Исключение КонецПопытки;
		Если НовДанныеТаблицы = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		НовСтроки = Неопределено;
		Попытка НовСтроки = НовДанныеТаблицы["rows"]; Исключение КонецПопытки;
		Если НовСтроки <> Неопределено И НовСтроки.Количество() > 0 Тогда
			Продолжить;
		КонецЕсли;

		ПутьТаблицы = "";
		ЭлементПутьТаблицы = "";
		ИмяТаблицы = "";
		Попытка ПутьТаблицы = СокрЛП(Строка(НоваяТаблица["path"])); Исключение КонецПопытки;
		Попытка ЭлементПутьТаблицы = СокрЛП(Строка(НоваяТаблица["elementPath"])); Исключение КонецПопытки;
		Попытка ИмяТаблицы = СокрЛП(Строка(НоваяТаблица["name"])); Исключение КонецПопытки;

		СтараяТаблица = KOTFEBridge_НайтиТаблицуВСнимке(СтарыеТаблицы, ПутьТаблицы, ЭлементПутьТаблицы, ИмяТаблицы);
		Если СтараяТаблица = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		СтарДанныеТаблицы = Неопределено;
		Попытка СтарДанныеТаблицы = СтараяТаблица["tableData"]; Исключение КонецПопытки;
		Если СтарДанныеТаблицы = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Если НЕ KOTFEBridge_КолонкиТаблицСовпадают(НовДанныеТаблицы, СтарДанныеТаблицы) Тогда
			Продолжить;
		КонецЕсли;

		СтарСтроки = Неопределено;
		Попытка СтарСтроки = СтарДанныеТаблицы["rows"]; Исключение КонецПопытки;
		ЕстьСтарыйRowCount = Ложь;
		Попытка ЕстьСтарыйRowCount = СтарДанныеТаблицы.Свойство("rowCount"); Исключение КонецПопытки;
		Если (СтарСтроки = Неопределено Или СтарСтроки.Количество() = 0) И НЕ ЕстьСтарыйRowCount Тогда
			Продолжить;
		КонецЕсли;

		Если СтарСтроки <> Неопределено Тогда
			НовДанныеТаблицы.Вставить("rows", СтарСтроки);
		КонецЕсли;
		Если ЕстьСтарыйRowCount Тогда
			Попытка НовДанныеТаблицы.Вставить("rowCount", СтарДанныеТаблицы["rowCount"]); Исключение КонецПопытки;
		КонецЕсли;
		Попытка
			Если СтарДанныеТаблицы.Свойство("truncated") Тогда
				НовДанныеТаблицы.Вставить("truncated", СтарДанныеТаблицы["truncated"]);
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Функция KOTFEBridge_НайтиТаблицуВСнимке(Таблицы, ПутьТаблицы, ЭлементПутьТаблицы, ИмяТаблицы)
	Если Таблицы = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Для Каждого Таблица Из Таблицы Цикл
		КандидатПуть = "";
		КандидатЭлементПуть = "";
		КандидатИмя = "";
		Попытка КандидатПуть = СокрЛП(Строка(Таблица["path"])); Исключение КонецПопытки;
		Попытка КандидатЭлементПуть = СокрЛП(Строка(Таблица["elementPath"])); Исключение КонецПопытки;
		Попытка КандидатИмя = СокрЛП(Строка(Таблица["name"])); Исключение КонецПопытки;

		Если НЕ ПустаяСтрока(ПутьТаблицы) И КандидатПуть = ПутьТаблицы Тогда
			Возврат Таблица;
		КонецЕсли;
		Если НЕ ПустаяСтрока(ЭлементПутьТаблицы) И КандидатЭлементПуть = ЭлементПутьТаблицы Тогда
			Возврат Таблица;
		КонецЕсли;
		Если НЕ ПустаяСтрока(ИмяТаблицы) И КандидатИмя = ИмяТаблицы Тогда
			Возврат Таблица;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;
КонецФункции

&НаКлиенте
Функция KOTFEBridge_КолонкиТаблицСовпадают(НовДанныеТаблицы, СтарДанныеТаблицы)
	Если НовДанныеТаблицы = Неопределено Или СтарДанныеТаблицы = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	НовыеКолонки = Неопределено;
	СтарыеКолонки = Неопределено;
	Попытка НовыеКолонки = НовДанныеТаблицы["columns"]; Исключение КонецПопытки;
	Попытка СтарыеКолонки = СтарДанныеТаблицы["columns"]; Исключение КонецПопытки;
	Если НовыеКолонки = Неопределено Или СтарыеКолонки = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Если НовыеКолонки.Количество() <> СтарыеКолонки.Количество() Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Индекс = 0 По НовыеКолонки.Количество() - 1 Цикл
		Если СокрЛП(Строка(НовыеКолонки[Индекс])) <> СокрЛП(Строка(СтарыеКолонки[Индекс])) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;
КонецФункции

&НаКлиенте
Функция KOTFEBridge_ПрочитатьКонтекстЗапроса()
	Результат = Новый Структура("elementPath", "");
	ПутьКонтекста = KOTFEBridge_ПолучитьПутьФайлаКонтекстаЗапроса();
	Если ПустаяСтрока(ПутьКонтекста) Тогда
		Возврат Результат;
	КонецЕсли;

	Попытка
		ФайлКонтекста = Новый Файл(ПутьКонтекста);
		Если НЕ ФайлКонтекста.Существует() Тогда
			Возврат Результат;
		КонецЕсли;
	Исключение
		Возврат Результат;
	КонецПопытки;

	Попытка
		Чтение = Новый ЧтениеJSON;
		Чтение.ОткрытьФайл(ПутьКонтекста);
		Контекст = ПрочитатьJSON(Чтение);
		Чтение.Закрыть();
		Если Контекст <> Неопределено Тогда
			Попытка Результат.elementPath = СокрЛП(Строка(Контекст["elementPath"])); Исключение КонецПопытки;
		КонецЕсли;
	Исключение
	КонецПопытки;

	Возврат Результат;
КонецФункции

&НаКлиенте
Процедура KOTFEBridge_УдалитьЗапрос()
	Попытка УдалитьФайлы(KOTFEBridge_RequestFilePath); Исключение КонецПопытки;
	Попытка
		ПутьКонтекста = KOTFEBridge_ПолучитьПутьФайлаКонтекстаЗапроса();
		Если НЕ ПустаяСтрока(ПутьКонтекста) Тогда
			УдалитьФайлы(ПутьКонтекста);
		КонецЕсли;
	Исключение
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Функция KOTFEBridge_НужноАвтоОбновление()
	// Use in-memory tick instead of file mtime to avoid OS-level file cache issues on network paths
	Если KOTFEBridge_ПоследнееОбновлениеТик = 0 Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат (ТекущаяДата() - KOTFEBridge_ПоследнееОбновлениеТик) >= KOTFEBridge_AutoIntervalSeconds;
КонецФункции

&НаКлиенте
Процедура KOTFEBridge_ЗаписатьМодСостояние(Режим)
	Если ПустаяСтрока(KOTFEBridge_ModeStatePath) Тогда Возврат; КонецЕсли;
	Попытка
		ТД = Новый ТекстовыйДокумент;
		ТД.УстановитьТекст(Режим);
		ТД.Записать(KOTFEBridge_ModeStatePath, КодировкаТекста.UTF8);
	Исключение
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура KOTFEBridge_ЗаписатьСнимок(Снимок)
	ИмяВрем = ПолучитьИмяВременногоФайла("json");
	Попытка
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.ОткрытьФайл(ИмяВрем);
		ЗаписатьJSON(ЗаписьJSON, Снимок);
		ЗаписьJSON.Закрыть();
		КопироватьФайл(ИмяВрем, KOTFEBridge_SnapshotPath);
	Исключение
		ВызватьИсключение "Ошибка записи снимка: " + ОписаниеОшибки();
	КонецПопытки;
	Попытка УдалитьФайлы(ИмяВрем); Исключение КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура KOTFEBridge_ЗаписатьСтатус(СтрокаСтатуса)
	Если ПустаяСтрока(KOTFEBridge_StatusFilePath) Тогда Возврат; КонецЕсли;
	Попытка
		ТД = Новый ТекстовыйДокумент;
		ТД.УстановитьТекст(СтрокаСтатуса);
		ТД.Записать(KOTFEBridge_StatusFilePath, КодировкаТекста.UTF8);
	Исключение
	КонецПопытки;
КонецПроцедуры
