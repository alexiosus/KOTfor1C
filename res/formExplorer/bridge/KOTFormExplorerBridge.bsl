&НаКлиенте
Функция KOTFEBridge_ПрочитатьСтрокиТаблицы(ТаблОбъект, КолонкиКоды)
	МаксСтрок = 50;
	Рез = Новый Структура("rows,rowCount", Новый Массив, 0);

	Если ТаблОбъект = Неопределено Тогда
		Возврат Рез;
	КонецЕсли;

	// Step 1: get total row count via ВыделитьВсеСтроки (most reliable count method)
	КолВоСтрок = 0;
	Попытка
		ТаблОбъект.ВыделитьВсеСтроки();
		ВыделенныеСтроки = ТаблОбъект.ПолучитьВыделенныеСтроки();
		Если ВыделенныеСтроки <> Неопределено Тогда
			КолВоСтрок = ВыделенныеСтроки.Количество();
		КонецЕсли;
	Исключение
	КонецПопытки;
	Рез.rowCount = КолВоСтрок;
	Если КолВоСтрок = 0 Тогда
		Возврат Рез;
	КонецЕсли;
	Если КолВоСтрок > МаксСтрок Тогда
		Рез.Вставить("truncated", Истина);
	КонецЕсли;

	// Step 2: navigate row by row with ПолучитьТекстЯчейки — returns display text for all types
	// including references (cross-IB Строка() returns empty for references, this does not).
	Попытка
		ТаблОбъект.ПерейтиКПервойСтроке();
	Исключение
		Возврат Рез;
	КонецПопытки;

	ФактОбработать = ?(КолВоСтрок > МаксСтрок, МаксСтрок, КолВоСтрок);
	НомерСтроки = 0;
	Пока НомерСтроки < ФактОбработать Цикл
		Попытка
			СтрокаЗначений = Новый Массив;
			Для Каждого КодИмя Из КолонкиКоды Цикл
				ЗнчКолонки = "";
				Попытка
					ЗнчКолонки = СокрЛП(Строка(ТаблОбъект.ПолучитьТекстЯчейки(КодИмя)));
				Исключение
				КонецПопытки;
				СтрокаЗначений.Добавить(ЗнчКолонки);
			КонецЦикла;
			Рез.rows.Добавить(СтрокаЗначений);
			НомерСтроки = НомерСтроки + 1;
		Исключение
			Прервать;
		КонецПопытки;
		Если НомерСтроки < ФактОбработать Тогда
			Попытка
				ТаблОбъект.ПерейтиКСледующейСтроке();
			Исключение
				Прервать;
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;

	Возврат Рез;
КонецФункции

&НаКлиенте
Функция KOTFEBridge_СобратьОписаниеКолонокТаблицы(ТаблОбъект, ИмяТаблицы = "")
	Результат = Новый Массив;
	Если ТаблОбъект = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	КоллекцияКолонок = KOTFEBridge_ПолучитьКоллекциюКолонокТаблицы(ТаблОбъект);
	Если КоллекцияКолонок = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Попытка
		Для Каждого КолонкаТаблицы Из КоллекцияКолонок Цикл
			ВидимостьКолонки = Истина;
			Попытка
				ВидимостьКолонки = КолонкаТаблицы.Видимость;
			Исключение
				Попытка ВидимостьКолонки = КолонкаТаблицы.Visible; Исключение КонецПопытки;
			КонецПопытки;
			Если ВидимостьКолонки = Ложь Тогда
				Продолжить;
			КонецЕсли;

			ИмяКолонки = "";
			Попытка
				ИмяКолонки = СокрЛП(Строка(КолонкаТаблицы.Имя));
			Исключение
				Попытка ИмяКолонки = СокрЛП(Строка(КолонкаТаблицы.Name)); Исключение КонецПопытки;
			КонецПопытки;

			Если ПустаяСтрока(ИмяКолонки) Тогда
				ПутьДанныхКолонки = "";
				Попытка
					ПутьДанныхКолонки = СокрЛП(Строка(КолонкаТаблицы.ПутьКДанным));
				Исключение
					Попытка
						ПутьДанныхКолонки = СокрЛП(Строка(КолонкаТаблицы.DataPath));
					Исключение
						Попытка ПутьДанныхКолонки = СокрЛП(Строка(КолонкаТаблицы.Data)); Исключение КонецПопытки;
					КонецПопытки;
				КонецПопытки;
				ИмяКолонки = KOTFEBridge_ПоследнийСегментПути(ПутьДанныхКолонки);
			КонецЕсли;

			Если ПустаяСтрока(ИмяКолонки) Тогда
				Продолжить;
			КонецЕсли;

			ЗаголовокКолонки = "";
			Попытка
				ЗаголовокКолонки = СокрЛП(Строка(КолонкаТаблицы.Заголовок));
			Исключение
				Попытка
					ЗаголовокКолонки = СокрЛП(Строка(КолонкаТаблицы.Title));
				Исключение
					Попытка ЗаголовокКолонки = СокрЛП(Строка(КолонкаТаблицы.Подсказка)); Исключение КонецПопытки;
				КонецПопытки;
			КонецПопытки;

			ОписаниеКолонки = Новый Структура;
			ОписаниеКолонки.Вставить("name", ИмяКолонки);
			ОписаниеКолонки.Вставить("shortName", KOTFEBridge_УбратьПрефиксТаблицыУКолонки(ИмяКолонки, ИмяТаблицы));
			ОписаниеКолонки.Вставить("title", ЗаголовокКолонки);
			Результат.Добавить(ОписаниеКолонки);
		КонецЦикла;
	Исключение
	КонецПопытки;

	Возврат Результат;
КонецФункции

&НаКлиенте
Функция KOTFEBridge_ПолучитьКоллекциюКолонокТаблицы(ТаблОбъект)
	Если ТаблОбъект = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Возврат ТаблОбъект.Колонки;
	Исключение
	КонецПопытки;

	Попытка
		Возврат ТаблОбъект.Columns;
	Исключение
	КонецПопытки;

	Возврат Неопределено;
КонецФункции

&НаКлиенте
Функция KOTFEBridge_НайтиОписаниеКолонкиТаблицы(ОписаниеКолонок, ИмяКолонки, ИмяТаблицы = "")
	Если ОписаниеКолонок = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	НормИмяКолонки = НРег(СокрЛП(Строка(ИмяКолонки)));
	НормКороткоеИмя = НРег(KOTFEBridge_УбратьПрефиксТаблицыУКолонки(ИмяКолонки, ИмяТаблицы));
	Для Каждого ОписаниеКолонки Из ОписаниеКолонок Цикл
		ИмяИзОписания = "";
		КороткоеИмяИзОписания = "";
		Попытка ИмяИзОписания = НРег(СокрЛП(Строка(ОписаниеКолонки["name"]))); Исключение КонецПопытки;
		Попытка КороткоеИмяИзОписания = НРег(СокрЛП(Строка(ОписаниеКолонки["shortName"]))); Исключение КонецПопытки;
		Если ИмяИзОписания = НормИмяКолонки Тогда
			Возврат ОписаниеКолонки;
		КонецЕсли;
		Если НЕ ПустаяСтрока(НормКороткоеИмя) И КороткоеИмяИзОписания = НормКороткоеИмя Тогда
			Возврат ОписаниеКолонки;
		КонецЕсли;
		Если НЕ ПустаяСтрока(НормКороткоеИмя) И ИмяИзОписания = НормКороткоеИмя Тогда
			Возврат ОписаниеКолонки;
		КонецЕсли;
		Если НЕ ПустаяСтрока(КороткоеИмяИзОписания) И КороткоеИмяИзОписания = НормИмяКолонки Тогда
			Возврат ОписаниеКолонки;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;
КонецФункции

&НаКлиенте
Функция KOTFEBridge_УбратьПрефиксТаблицыУКолонки(ИмяКолонки, ИмяТаблицы = "")
	Результат = СокрЛП(Строка(ИмяКолонки));
	Префикс = СокрЛП(Строка(ИмяТаблицы));
	Если ПустаяСтрока(Результат) Или ПустаяСтрока(Префикс) Тогда
		Возврат Результат;
	КонецЕсли;

	Если СтрДлина(Результат) > СтрДлина(Префикс)
		И Лев(НРег(Результат), СтрДлина(Префикс)) = НРег(Префикс) Тогда
		Возврат Сред(Результат, СтрДлина(Префикс) + 1);
	КонецЕсли;

	Возврат Результат;
КонецФункции

&НаКлиенте
Функция KOTFEBridge_ПоследнийСегментПути(Путь)
	ЗначениеПути = СокрЛП(Строка(Путь));
	Если ПустаяСтрока(ЗначениеПути) Тогда
		Возврат "";
	КонецЕсли;

	ЧастиПути = СтрРазделить(ЗначениеПути, ".");
	Если ЧастиПути = Неопределено Или ЧастиПути.Количество() = 0 Тогда
		Возврат ЗначениеПути;
	КонецЕсли;

	Возврат ЧастиПути[ЧастиПути.ВГраница()];
КонецФункции

&НаКлиенте
Функция KOTFEBridge_ПутьНаходитсяВТаблице(ПутьЭлемента, ПутьТаблицы)
	НормПутьЭлемента = СокрЛП(Строка(ПутьЭлемента));
	НормПутьТаблицы = СокрЛП(Строка(ПутьТаблицы));
	Если ПустаяСтрока(НормПутьЭлемента) Или ПустаяСтрока(НормПутьТаблицы) Тогда
		Возврат Ложь;
	КонецЕсли;

	Если НормПутьЭлемента = НормПутьТаблицы Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат Лев(НормПутьЭлемента, СтрДлина(НормПутьТаблицы) + 1) = НормПутьТаблицы + ".";
КонецФункции

&НаКлиенте
Процедура KOTFEBridge_ДобавитьКолонкиТаблицыИзДерева(Элементы, ИмяТаблицы, ЖивыеКолонкиПоИмени, ОписаниеКолонокТаблицы, КолонкиКоды, КолонкиОтображение, ДобавленныеКолонки, РодителиВидимы = Истина, Глубина = 0)
	Если Элементы = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Для Каждого ДочЭл Из Элементы Цикл
		ВидДоч = "";
		Попытка ВидДоч = ДочЭл["kind"]; Исключение КонецПопытки;

		ТекущийЭлементВидим = РодителиВидимы;
		Попытка
			Если ДочЭл["visible"] = Ложь Тогда
				ТекущийЭлементВидим = Ложь;
			КонецЕсли;
		Исключение
		КонецПопытки;

		Если СтрНайти(ВидДоч, "Field") > 0 Тогда
			КодИмя = "";
			Попытка КодИмя = СокрЛП(Строка(ДочЭл["name"])); Исключение КонецПопытки;
			Если НЕ ПустаяСтрока(КодИмя) Тогда
				КлючКолонки = НРег(КодИмя);
				Если ДобавленныеКолонки.Получить(КлючКолонки) = Неопределено Тогда
					ОписаниеКолонки = Неопределено;
					Если ОписаниеКолонокТаблицы <> Неопределено И ОписаниеКолонокТаблицы.Количество() > 0 Тогда
						ОписаниеКолонки = KOTFEBridge_НайтиОписаниеКолонкиТаблицы(ОписаниеКолонокТаблицы, КодИмя, ИмяТаблицы);
					КонецЕсли;

					ВключитьКолонку = Ложь;
					Если ОписаниеКолонки <> Неопределено Тогда
						ВключитьКолонку = Истина;
					Иначе
						ВключитьКолонку = РодителиВидимы И ?(Глубина > 0, Истина, ТекущийЭлементВидим);
						Если ВключитьКолонку И Глубина = 0 Тогда
							ЖивойКолЭл = ЖивыеКолонкиПоИмени.Получить(КодИмя);
							Если ЖивойКолЭл <> Неопределено Тогда
								ВключитьКолонку = Ложь;
								Попытка ВключитьКолонку = ЖивойКолЭл.ТекущаяВидимость(); Исключение КонецПопытки;
							КонецЕсли;
						КонецЕсли;
					КонецЕсли;

					Если ВключитьКолонку Тогда
						ОтобрИмя = "";
						Попытка ОтобрИмя = СокрЛП(Строка(ДочЭл["title"])); Исключение КонецПопытки;
						Если ОписаниеКолонки <> Неопределено Тогда
							Попытка
								Если НЕ ПустаяСтрока(ОписаниеКолонки["title"]) Тогда
									ОтобрИмя = ОписаниеКолонки["title"];
								КонецЕсли;
							Исключение
							КонецПопытки;
						КонецЕсли;
						КолонкиКоды.Добавить(КодИмя);
						КолонкиОтображение.Добавить(?(ПустаяСтрока(ОтобрИмя), КодИмя, ОтобрИмя));
						ДобавленныеКолонки.Вставить(КлючКолонки, Истина);
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;

		ДочерниеЭлементы = Неопределено;
		Попытка ДочерниеЭлементы = ДочЭл["children"]; Исключение КонецПопытки;
		Если ДочерниеЭлементы <> Неопределено И ДочерниеЭлементы.Количество() > 0 Тогда
			KOTFEBridge_ДобавитьКолонкиТаблицыИзДерева(
				ДочерниеЭлементы,
				ИмяТаблицы,
				ЖивыеКолонкиПоИмени,
				ОписаниеКолонокТаблицы,
				КолонкиКоды,
				КолонкиОтображение,
				ДобавленныеКолонки,
				ТекущийЭлементВидим,
				Глубина + 1
			);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// ────────────────────────────────────────────────────────────────────────────
// Recursive element tree traversal (Vanessa methodology)
// ────────────────────────────────────────────────────────────────────────────

&НаКлиенте
Процедура KOTFEBridge_ОбойтиЭлементы(КонтролРодитель, ПутьРодителя, ПлоскиеЭлементы, МассивДочерних, ОбъектыТаблиц)

	МассивПодчиненных = Неопределено;
	Попытка
		МассивПодчиненных = КонтролРодитель.ПолучитьПодчиненныеОбъекты();
	Исключение
		Попытка
			МассивПодчиненных = КонтролРодитель.НайтиОбъекты();
		Исключение
			Возврат;
		КонецПопытки;
	КонецПопытки;

	Если МассивПодчиненных = Неопределено Тогда Возврат; КонецЕсли;

	Для Каждого ТекЭлемент Из МассивПодчиненных Цикл

		Имя  = KOTFEBridge_ПолучитьИмяЭлемента(ТекЭлемент);
		Путь = ?(ПустаяСтрока(ПутьРодителя), Имя, ПутьРодителя + "." + Имя);

		// Track table objects for row reading (local variable — not a form attribute)
		Если ТипЗнч(ТекЭлемент) = Тип("ТестируемаяТаблицаФормы") Тогда
			ОбъектыТаблиц.Вставить(Путь, ТекЭлемент);
		КонецЕсли;

		ОписаниеЭлемента = Новый Структура;
		ОписаниеЭлемента.Вставить("path",       Путь);
		ОписаниеЭлемента.Вставить("parentPath", ПутьРодителя);
		ОписаниеЭлемента.Вставить("name",       Имя);
		ОписаниеЭлемента.Вставить("title",      KOTFEBridge_ПолучитьЗаголовок(ТекЭлемент));
		ОписаниеЭлемента.Вставить("synonym",    KOTFEBridge_ПолучитьЗаголовок(ТекЭлемент));
		ОписаниеЭлемента.Вставить("kind",       KOTFEBridge_ПолучитьВид(ТекЭлемент));
		ОписаниеЭлемента.Вставить("type",       Строка(ТипЗнч(ТекЭлемент)));

		// runtime visibility — the key Vanessa advantage over design-time extension
		Видимость      = Ложь;
		Доступность    = Ложь;
		ТолькоПросмотр = Ложь;
		Попытка Видимость      = ТекЭлемент.ТекущаяВидимость();       Исключение КонецПопытки;
		Попытка Доступность    = ТекЭлемент.ТекущаяДоступность();     Исключение КонецПопытки;
		Попытка ТолькоПросмотр = ТекЭлемент.ТекущееТолькоПросмотр(); Исключение КонецПопытки;

		// Value reading from structural (design-time) objects is not supported by standard TestClient API.
		// Values are enriched separately via НайтиОбъекты live elements after the walk.
		ПредпросмотрЗначения = "";

		ОписаниеЭлемента.Вставить("visible",      Видимость);
		ОписаниеЭлемента.Вставить("available",    Доступность);
		ОписаниеЭлемента.Вставить("enabled",      Доступность);
		ОписаниеЭлемента.Вставить("readOnly",     ТолькоПросмотр);
		ОписаниеЭлемента.Вставить("active",       Ложь);
		ОписаниеЭлемента.Вставить("valuePreview", ПредпросмотрЗначения);
		ОписаниеЭлемента.Вставить("metadataPath", "");

		ДочерниеЭлементы = Новый Массив;
		KOTFEBridge_ОбойтиЭлементы(ТекЭлемент, Путь, ПлоскиеЭлементы, ДочерниеЭлементы, ОбъектыТаблиц);
		ОписаниеЭлемента.Вставить("children", ДочерниеЭлементы);

		ПлоскиеЭлементы.Добавить(ОписаниеЭлемента);
		МассивДочерних.Добавить(ОписаниеЭлемента);

	КонецЦикла;

КонецПроцедуры

// ────────────────────────────────────────────────────────────────────────────
// Element property helpers
// ────────────────────────────────────────────────────────────────────────────

&НаКлиенте
Функция KOTFEBridge_ПолучитьИмяЭлемента(Элемент)
	Попытка
		Возврат Элемент.Имя;
	Исключение
	КонецПопытки;
	Возврат Строка(ТипЗнч(Элемент));
КонецФункции

&НаКлиенте
Функция KOTFEBridge_ПолучитьЗаголовок(Элемент)
	Попытка
		Зн = Элемент.ТекстЗаголовка;
		Если НЕ ПустаяСтрока(СокрЛП(Строка(Зн))) Тогда
			Возврат Строка(Зн);
		КонецЕсли;
	Исключение КонецПопытки;
	Возврат "";
КонецФункции

&НаКлиенте
Функция KOTFEBridge_ПолучитьВид(Элемент)
	Тип = ТипЗнч(Элемент);
	Если Тип = Тип("ТестируемаяТаблицаФормы")   Тогда Возврат "Table";      КонецЕсли;
	Если Тип = Тип("ТестируемаяКнопкаФормы")    Тогда Возврат "Button";     КонецЕсли;
	Если Тип = Тип("ТестируемаяГруппаФормы")    Тогда Возврат "Group";      КонецЕсли;
	Если Тип = Тип("ТестируемаяДекорацияФормы") Тогда Возврат "Decoration"; КонецЕсли;
	Если Тип = Тип("ТестируемоеПолеФормы") Тогда
		Попытка
			Вид = Элемент.Вид;
			Если Вид = ВидПоляФормы.ПолеФлажка              Тогда Возврат "CheckBoxField";    КонецЕсли;
			Если Вид = ВидПоляФормы.ПолеПереключателя       Тогда Возврат "RadioButtonField"; КонецЕсли;
			Если Вид = ВидПоляФормы.ПолеНадписи             Тогда Возврат "LabelField";       КонецЕсли;
			Если Вид = ВидПоляФормы.ПолеТабличногоДокумента Тогда Возврат "SpreadsheetField"; КонецЕсли;
			Если Вид = ВидПоляФормы.ПолеВвода               Тогда Возврат "InputField";       КонецЕсли;
			Если Вид = ВидПоляФормы.ПолеКартинки            Тогда Возврат "PictureField";     КонецЕсли;
		Исключение КонецПопытки;
		Возврат "Field";
	КонецЕсли;
	Возврат Строка(Тип);
КонецФункции

