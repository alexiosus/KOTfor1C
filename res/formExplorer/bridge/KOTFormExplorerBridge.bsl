// KOT Form Explorer Bridge — EPF form module.
// Opened in the startup infobase launched with /TestManager.
// Config JSON path is received via ПараметрЗапуска (passed with /C flag at launch).
//
// Required form attributes (Реквизиты формы):
//   KOTFEBridge_ПоследняяОшибка           — String
//   KOTFEBridge_IsAutoMode                — Boolean
//   KOTFEBridge_SnapshotPath              — String
//   KOTFEBridge_RequestFilePath           — String
//   KOTFEBridge_ModeStatePath             — String
//   KOTFEBridge_StatusFilePath            — String
//   KOTFEBridge_TestClientPort            — Number
//   KOTFEBridge_WorkingInfobaseConnection — String
//   KOTFEBridge_AutoIntervalSeconds       — Number
//
//   KOTFEBridge_ПоследнееОбновлениеТик     — Number  (stores ТекущаяДата() as seconds since epoch)
//
// Note: form open event must be bound to OnOpen (English 1C) or ПриОткрытии (Russian 1C).
// Note: ТестируемоеПриложение is NOT stored as a form attribute — it is created fresh
//       each poll tick as a local variable, because it cannot be serialized between ticks.

// ────────────────────────────────────────────────────────────────────────────
// Startup
// ────────────────────────────────────────────────────────────────────────────

&НаКлиенте
Процедура OnOpen(Cancel)

	// defaults
	KOTFEBridge_IsAutoMode          = Истина;
	KOTFEBridge_TestClientPort      = 1538;
	KOTFEBridge_AutoIntervalSeconds = 3;

	КонфигПуть = СокрЛП(ПараметрЗапуска);
	Если НЕ ПустаяСтрока(КонфигПуть) Тогда
		// Derive status path from config path before reading JSON so errors are visible
		ЧастиПути = СтрРазделить(КонфигПуть, "\");
		ЧастиПути.Удалить(ЧастиПути.ВГраница());
		KOTFEBridge_StatusFilePath = СтрСоединить(ЧастиПути, "\") + "\bridge-status.txt";

		Попытка
			Чтение = Новый ЧтениеJSON;
			Чтение.ОткрытьФайл(КонфигПуть);
			Конфиг = ПрочитатьJSON(Чтение);
			Чтение.Закрыть();
			KOTFEBridge_SnapshotPath              = Конфиг.snapshotPath;
			KOTFEBridge_RequestFilePath           = Конфиг.requestFilePath;
			KOTFEBridge_ModeStatePath             = Конфиг.modeStatePath;
			KOTFEBridge_StatusFilePath            = Конфиг.statusFilePath;
			KOTFEBridge_TestClientPort            = Конфиг.testClientPort;
			KOTFEBridge_WorkingInfobaseConnection = Конфиг.workingInfobaseConnection;
			KOTFEBridge_AutoIntervalSeconds       = Конфиг.autoIntervalSeconds;
		Исключение
			KOTFEBridge_ЗаписатьСтатус("error:config:" + ОписаниеОшибки());
			Возврат;
		КонецПопытки;
	КонецЕсли;

	KOTFEBridge_ПоследняяОшибка    = "";
	KOTFEBridge_ПоследнееОбновлениеТик = 0; // zero — force first update immediately
	KOTFEBridge_ЗаписатьСостояниеМоста(KOTFEBridge_ПолучитьСостояниеМостаПоУмолчанию());

	KOTFEBridge_ЗаписатьМодСостояние("auto");
	KOTFEBridge_ЗаписатьСтатус("starting");
	ПодключитьОбработчикОжидания("KOTFEBridge_ЦиклОпроса", 1, Ложь);

КонецПроцедуры

// ────────────────────────────────────────────────────────────────────────────
// Main poll loop (runs every second)
// ────────────────────────────────────────────────────────────────────────────

&НаКлиенте
Процедура KOTFEBridge_ЦиклОпроса()

	СостояниеМоста = KOTFEBridge_ПрочитатьСостояниеМоста();
	Если СостояниеМоста.selfShutdownRequested Тогда
		Возврат;
	КонецЕсли;

	// Process mode/refresh request if present
	ЕстьЗапрос               = Ложь;
	ЗапросЛокатора           = Ложь;
	НужныСтрокиТабл          = Ложь;
	ПутьЗапрошенногоЭлемента = "";
	Если KOTFEBridge_ЕстьЗапросОбновления() Тогда
		КодЗапроса = KOTFEBridge_ПрочитатьКодЗапроса();
		КонтекстЗапроса = KOTFEBridge_ПрочитатьКонтекстЗапроса();
		Попытка
			ПутьЗапрошенногоЭлемента = СокрЛП(Строка(КонтекстЗапроса.elementPath));
		Исключение
			ПутьЗапрошенногоЭлемента = "";
		КонецПопытки;
		KOTFEBridge_УдалитьЗапрос();
		Если КодЗапроса = "auto" Тогда
			KOTFEBridge_IsAutoMode = Истина;
			KOTFEBridge_ЗаписатьМодСостояние("auto");
			СостояниеМоста.locatorActive = Ложь;
			СостояниеМоста.locatorBaseSignature = "";
			KOTFEBridge_ЗаписатьСостояниеМоста(СостояниеМоста);
		ИначеЕсли КодЗапроса = "manual" Тогда
			KOTFEBridge_IsAutoMode = Ложь;
			KOTFEBridge_ЗаписатьМодСостояние("manual");
			СостояниеМоста.locatorActive = Ложь;
			СостояниеМоста.locatorBaseSignature = "";
			KOTFEBridge_ЗаписатьСостояниеМоста(СостояниеМоста);
		ИначеЕсли КодЗапроса = "locator" Тогда
			ЗапросЛокатора = Истина;
		ИначеЕсли КодЗапроса = "table" Тогда
			ЕстьЗапрос      = Истина;
			НужныСтрокиТабл = Истина;
		Иначе
			ЕстьЗапрос = Истина; // refresh or unknown
		КонецЕсли;
	КонецЕсли;

	АвтоОбновление = KOTFEBridge_IsAutoMode И KOTFEBridge_НужноАвтоОбновление();
	ЛокаторАктивен = СостояниеМоста.locatorActive = Истина;
	НужнаПроверкаСвязи = KOTFEBridge_НужноПроверитьСвязьСТестКлиентом(СостояниеМоста, ЕстьЗапрос, АвтоОбновление);

	Если ЕстьЗапрос Или АвтоОбновление Или ЗапросЛокатора Или ЛокаторАктивен Или НужнаПроверкаСвязи Тогда
		Попытка
			// Create fresh each tick — ТестируемоеПриложение cannot be stored between ticks
			ТестПриложение = Новый ТестируемоеПриложение("localhost", KOTFEBridge_TestClientPort);
			KOTFEBridge_ЗафиксироватьУспешнуюСвязьСТестКлиентом(СостояниеМоста);
			Если ЗапросЛокатора Тогда
				БазовыйСнимокЛокатора = KOTFEBridge_СобратьСнимок(ТестПриложение, Ложь, ПутьЗапрошенногоЭлемента);
				БазоваяСигнатураЛокатора = KOTFEBridge_ПостроитьБыструюСигнатуруСнимка(БазовыйСнимокЛокатора);
				СостояниеМоста.locatorActive = Истина;
				СостояниеМоста.locatorBaseSignature = БазоваяСигнатураЛокатора;
				KOTFEBridge_ЗаписатьСостояниеМоста(СостояниеМоста);
				KOTFEBridge_ЗаписатьСтатус("locator:armed");
			ИначеЕсли ЕстьЗапрос Или АвтоОбновление Тогда
				Снимок = KOTFEBridge_СобратьСнимок(ТестПриложение, НужныСтрокиТабл, ПутьЗапрошенногоЭлемента);
				Если Снимок <> Неопределено Тогда
					ПредыдущийСнимок = Неопределено;
					Если НЕ НужныСтрокиТабл Тогда
						ПредыдущийСнимок = KOTFEBridge_ПрочитатьСуществующийСнимок();
						KOTFEBridge_СохранитьРанееЗагруженныеТаблицы(Снимок, ПредыдущийСнимок);
					КонецЕсли;

					НужноЗаписыватьСнимок = Истина;
					Если АвтоОбновление И НЕ ЕстьЗапрос Тогда
						НужноЗаписыватьСнимок = НЕ KOTFEBridge_СнимкиРавныБезGeneratedAt(Снимок, ПредыдущийСнимок);
					КонецЕсли;

					Если НужноЗаписыватьСнимок Тогда
						KOTFEBridge_ЗаписатьСнимок(Снимок);
					КонецЕсли;
					KOTFEBridge_ПоследнееОбновлениеТик = ТекущаяДата();
					KOTFEBridge_ЗаписатьСтатус("ok");
				Иначе
					KOTFEBridge_ЗаписатьСтатус("waiting");
				КонецЕсли;
			ИначеЕсли ЛокаторАктивен Тогда
				СнимокЛокатора = KOTFEBridge_СобратьСнимок(ТестПриложение, Ложь, ПутьЗапрошенногоЭлемента);
				Если СнимокЛокатора <> Неопределено Тогда
					ТекущаяСигнатураЛокатора = KOTFEBridge_ПостроитьБыструюСигнатуруСнимка(СнимокЛокатора);
					БазоваяСигнатураЛокатора = СокрЛП(Строка(СостояниеМоста.locatorBaseSignature));
					ИзменениеЛокатора = Ложь;
					Если ПустаяСтрока(БазоваяСигнатураЛокатора) Тогда
						ИзменениеЛокатора = НЕ ПустаяСтрока(ТекущаяСигнатураЛокатора);
					Иначе
						ИзменениеЛокатора = ТекущаяСигнатураЛокатора <> БазоваяСигнатураЛокатора;
					КонецЕсли;

					Если ИзменениеЛокатора Тогда
						ПредыдущийСнимок = KOTFEBridge_ПрочитатьСуществующийСнимок();
						KOTFEBridge_СохранитьРанееЗагруженныеТаблицы(СнимокЛокатора, ПредыдущийСнимок);
						KOTFEBridge_ЗаписатьСнимок(СнимокЛокатора);
						KOTFEBridge_ПоследнееОбновлениеТик = ТекущаяДата();
						СостояниеМоста.locatorActive = Ложь;
						СостояниеМоста.locatorBaseSignature = "";
						KOTFEBridge_ЗаписатьСостояниеМоста(СостояниеМоста);
						KOTFEBridge_ЗаписатьСтатус("ok");
					Иначе
						KOTFEBridge_ЗаписатьСтатус("locator:waiting");
					КонецЕсли;
				Иначе
					KOTFEBridge_ЗаписатьСтатус("locator:waiting");
				КонецЕсли;
			Иначе
				// manual mode without refresh still pings TestClient so the bridge can
				// close itself if the working client disappears.
			КонецЕсли;
		Исключение
			KOTFEBridge_ПоследняяОшибка = ОписаниеОшибки();
			Если KOTFEBridge_ЭтоОшибкаПотериTestClient(KOTFEBridge_ПоследняяОшибка) Тогда
				Если KOTFEBridge_ОбработатьПотерюСвязиСТестКлиентом(СостояниеМоста, KOTFEBridge_ПоследняяОшибка) Тогда
					Возврат;
				КонецЕсли;
			КонецЕсли;
			KOTFEBridge_ЗаписатьСтатус("error:" + KOTFEBridge_ПоследняяОшибка);
		КонецПопытки;
	КонецЕсли;

	Если НЕ СостояниеМоста.selfShutdownRequested Тогда
		ПодключитьОбработчикОжидания("KOTFEBridge_ЦиклОпроса", 1, Ложь);
	КонецЕсли;

КонецПроцедуры

// ────────────────────────────────────────────────────────────────────────────
// Snapshot collection — Vanessa TestClient methodology
// ────────────────────────────────────────────────────────────────────────────

&НаКлиенте
Функция KOTFEBridge_СобратьСнимок(ТестПриложение, НужныСтрокиТаблиц, ПутьЗапрошенногоЭлемента = "")

	// Get active window via ПолучитьАктивноеОкно() — the correct Vanessa/TestClient approach
	ТекущееОкно  = Неопределено;
	ТекущаяФорма = Неопределено;
	Попытка
		ТекущееОкно = ТестПриложение.ПолучитьАктивноеОкно();
	Исключение
	КонецПопытки;

	Если ТекущееОкно <> Неопределено Тогда
		ТекущаяФорма = KOTFEBridge_НайтиФормуВОкне(ТекущееОкно);
	КонецЕсли;

	Если ТекущаяФорма = Неопределено Тогда
		ТекущаяФорма = KOTFEBridge_НайтиФормуВПриложении(ТестПриложение, ТекущееОкно);
	КонецЕсли;

	Если ТекущаяФорма = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	ЗнчЗаголовокОкна  = "";
	ЗнчЗаголовокФормы = "";
	ЗнчИмяФормы       = "";

	Если ТекущееОкно <> Неопределено Тогда
		Попытка ЗнчЗаголовокОкна = ТекущееОкно.Заголовок; Исключение КонецПопытки;
	КонецЕсли;
	Попытка ЗнчЗаголовокФормы = ТекущаяФорма.ТекстЗаголовка; Исключение КонецПопытки;
	Попытка ЗнчИмяФормы       = ТекущаяФорма.ИмяФормы;       Исключение КонецПопытки;

	// Collect element tree (recursive via ПолучитьПодчиненныеОбъекты — returns design-time structure)
	ПлоскиеЭлементы = Новый Массив;
	ДеревоЭлементов = Новый Массив;
	ОбъектыТаблиц   = Новый Соответствие; // path → ТестируемаяТаблицаФормы object
	ДиагИнфо = Новый Структура("живогоОшибки", "");
	KOTFEBridge_ОбойтиЭлементы(ТекущаяФорма, "", ПлоскиеЭлементы, ДеревоЭлементов, ОбъектыТаблиц);

	// Enrich valuePreview from live runtime elements (НайтиОбъекты returns proper typed proxies).
	// Try ПолучитьЗначение(), then .Текст and .Значение properties as fallbacks.
	Попытка
		ЖивыеЭлементы = ТекущаяФорма.НайтиОбъекты(Тип("ТестируемоеПолеФормы"));
		Если ЖивыеЭлементы <> Неопределено Тогда
			ЖивыеПоля = Новый Соответствие;
			Для Каждого ЖивойЭл Из ЖивыеЭлементы Цикл
				ИмяЖ = KOTFEBridge_ПолучитьИмяЭлемента(ЖивойЭл);
				Если НЕ ПустаяСтрока(ИмяЖ) Тогда
					ЖивыеПоля.Вставить(ИмяЖ, ЖивойЭл);
				КонецЕсли;
			КонецЦикла;
			ЖивыхНайдено  = 0;
			ЖивыхСоЗначен = 0;
			Для Каждого ОписЭл Из ПлоскиеЭлементы Цикл
				ЖивойЭл = ЖивыеПоля.Получить(ОписЭл["name"]);
				Если ЖивойЭл = Неопределено Тогда Продолжить; КонецЕсли;
				ЖивыхНайдено = ЖивыхНайдено + 1;
				Пред = "";
				// Standard TestClient API (same as Vanessa uses):
				// 1. ПолучитьТекстРедактирования() — for ПолеВвода (input fields)
				Попытка
					Зн   = ЖивойЭл.ПолучитьТекстРедактирования();
					Пред = СокрЛП(Строка(Зн));
				Исключение
					Если ПустаяСтрока(ДиагИнфо.живогоОшибки) Тогда
						ДиагИнфо.живогоОшибки = "ПолучитьТекстРед: " + СокрЛП(ОписаниеОшибки());
					КонецЕсли;
				КонецПопытки;
				// 2. ПолучитьОтображаемыйТекст() — platform 8.3.23+ when editing text is empty
				Если ПустаяСтрока(Пред) Тогда
					Попытка Пред = СокрЛП(Строка(ЖивойЭл.ПолучитьОтображаемыйТекст())); Исключение КонецПопытки;
				КонецЕсли;
				// 3. ПолучитьПредставлениеДанных() — fallback for all field types
				Если ПустаяСтрока(Пред) Тогда
					Попытка Пред = СокрЛП(Строка(ЖивойЭл.ПолучитьПредставлениеДанных())); Исключение КонецПопытки;
				КонецЕсли;
				Если НЕ ПустаяСтрока(Пред) Тогда
					ОписЭл["valuePreview"] = Пред;
					ЖивыхСоЗначен = ЖивыхСоЗначен + 1;
				КонецЕсли;
			КонецЦикла;
			ДиагИнфо.Вставить("живых",    ЖивыхНайдено);
			ДиагИнфо.Вставить("соЗначен", ЖивыхСоЗначен);
		КонецЕсли;
	Исключение
		Если ПустаяСтрока(ДиагИнфо.текстОшибки) Тогда
			ДиагИнфо.текстОшибки = "НайтиОбъекты-err: " + ОписаниеОшибки();
		КонецЕсли;
	КонецПопытки;

	// Similarly enrich ОбъектыТаблиц with live table objects (so row reading via ПолучитьЗначение works)
	Попытка
		ЖивыеТаблицы = ТекущаяФорма.НайтиОбъекты(Тип("ТестируемаяТаблицаФормы"));
		Если ЖивыеТаблицы <> Неопределено Тогда
			Для Каждого ЖивТабл Из ЖивыеТаблицы Цикл
				ИмяЖТ = KOTFEBridge_ПолучитьИмяЭлемента(ЖивТабл);
				Если НЕ ПустаяСтрока(ИмяЖТ) Тогда
					// Replace design-time objects with live ones for row reading
					Для Каждого Пара Из ОбъектыТаблиц Цикл
						Если СтрЗаканчиваетсяНа(Пара.Ключ, "." + ИмяЖТ) Или Пара.Ключ = ИмяЖТ Тогда
							ОбъектыТаблиц.Вставить(Пара.Ключ, ЖивТабл);
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	Исключение
	КонецПопытки;

	// Try to get the active (focused) element. JS decides whether to follow it automatically,
	// so setting activeElementPath here only reports focus without forcing scroll behavior.
	ПутьАктивного = "";
	Попытка
		АктивныйЭл = ТекущаяФорма.ПолучитьТекущийЭлемент();
		Если АктивныйЭл <> Неопределено Тогда
			ИмяАктивного = "";
			Попытка ИмяАктивного = АктивныйЭл.Имя; Исключение КонецПопытки;
			Если НЕ ПустаяСтрока(ИмяАктивного) Тогда
				Для Каждого ОписЭл Из ПлоскиеЭлементы Цикл
					Если ОписЭл["name"] = ИмяАктивного Тогда
						ПутьАктивного = ОписЭл["path"];
						Прервать;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
	Исключение
	КонецПопытки;

	// build tables array — columns from element tree, rows if requested
	МассивТаблицСнимка = Новый Массив;
	Для Каждого ОписЭл Из ПлоскиеЭлементы Цикл
		Если ОписЭл["kind"] <> "Table" Тогда Продолжить; КонецЕсли;

		// column display names (for snapshot columns array)
		КолонкиОтображение = Новый Массив;
		// column code names (for row reading API)
		КолонкиКоды        = Новый Массив;

		// Build a live field proxy map by name (used as a fallback when runtime column
		// descriptions are unavailable). НайтиОбъекты is recursive and returns too many
		// elements, so it is only a name→proxy lookup.
		ЖивыеКолонкиПоИмени = Новый Соответствие;
		ТаблОбъектКол = ОбъектыТаблиц.Получить(ОписЭл["path"]);
		ОписаниеКолонокТаблицы = KOTFEBridge_СобратьОписаниеКолонокТаблицы(ТаблОбъектКол, ОписЭл["name"]);
		Если ТаблОбъектКол <> Неопределено Тогда
			Попытка
				КолонкиЭлементы = ТаблОбъектКол.НайтиОбъекты(Тип("ТестируемоеПолеФормы"));
				Если КолонкиЭлементы <> Неопределено Тогда
					Для Каждого КолЭл Из КолонкиЭлементы Цикл
						ИмяКол = KOTFEBridge_ПолучитьИмяЭлемента(КолЭл);
						Если НЕ ПустаяСтрока(ИмяКол) Тогда
							ЖивыеКолонкиПоИмени.Вставить(ИмяКол, КолЭл);
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
			Исключение
			КонецПопытки;
		КонецЕсли;

		ДобавленныеКолонки = Новый Соответствие;
		KOTFEBridge_ДобавитьКолонкиТаблицыИзДерева(
			ОписЭл["children"],
			ОписЭл["name"],
			ЖивыеКолонкиПоИмени,
			ОписаниеКолонокТаблицы,
			КолонкиКоды,
			КолонкиОтображение,
			ДобавленныеКолонки,
			Истина,
			0
		);

		ДанныеТаблицы = Новый Структура;
		ДанныеТаблицы.Вставить("columns", КолонкиОтображение);

		НужноЧитатьСтрокиЭтойТаблицы = НужныСтрокиТаблиц;
		Если НужноЧитатьСтрокиЭтойТаблицы И НЕ ПустаяСтрока(ПутьЗапрошенногоЭлемента) Тогда
			НужноЧитатьСтрокиЭтойТаблицы = KOTFEBridge_ПутьНаходитсяВТаблице(ПутьЗапрошенногоЭлемента, ОписЭл["path"]);
		КонецЕсли;

		// Try to read rows if requested and this table matches the request context
		Если НужноЧитатьСтрокиЭтойТаблицы Тогда
			ТаблОбъект = ОбъектыТаблиц.Получить(ОписЭл["path"]);
			СтрокиРез  = KOTFEBridge_ПрочитатьСтрокиТаблицы(ТаблОбъект, КолонкиКоды);
			ДанныеТаблицы.Вставить("rows",     СтрокиРез.rows);
			ДанныеТаблицы.Вставить("rowCount", СтрокиРез.rowCount);
			Если СтрокиРез.Свойство("truncated") Тогда
				ДанныеТаблицы.Вставить("truncated", Истина);
			КонецЕсли;
		Иначе
			ДанныеТаблицы.Вставить("rows",     Новый Массив);
		КонецЕсли;

		ОписТаблицы = Новый Структура;
		ОписТаблицы.Вставить("path",        ОписЭл["path"]);
		ОписТаблицы.Вставить("name",        ОписЭл["name"]);
		ОписТаблицы.Вставить("title",       ОписЭл["title"]);
		ОписТаблицы.Вставить("elementPath", ОписЭл["path"]);
		ОписТаблицы.Вставить("tableData",   ДанныеТаблицы);
		МассивТаблицСнимка.Добавить(ОписТаблицы);
	КонецЦикла;

	Снимок = Новый Структура;
	Снимок.Вставить("schemaVersion", 1);
	Снимок.Вставить("generatedAt",   Формат(ТекущаяДата(), "ДФ=yyyy-MM-ddTHH:mm:ss"));

	ИсточникСнимка = Новый Структура;
	ИсточникСнимка.Вставить("infobase",  KOTFEBridge_WorkingInfobaseConnection);
	ИсточникСнимка.Вставить("sessionId", "TestClientBridge");
	Снимок.Вставить("source", ИсточникСнимка);

	ОписаниеФормы = Новый Структура;
	ОписаниеФормы.Вставить("title",             ЗнчЗаголовокФормы);
	ОписаниеФормы.Вставить("windowTitle",       ЗнчЗаголовокОкна);
	ОписаниеФормы.Вставить("name",              ЗнчИмяФормы);
	ОписаниеФормы.Вставить("metadataPath",      "");
	ОписаниеФормы.Вставить("type",              "ManagedForm");
	ОписаниеФормы.Вставить("activeElementPath", ПутьАктивного);
	Снимок.Вставить("form",       ОписаниеФормы);
	Снимок.Вставить("elements",   ДеревоЭлементов);
	Снимок.Вставить("tables",     МассивТаблицСнимка);
	Снимок.Вставить("attributes", Новый Массив);
	Снимок.Вставить("commands",   Новый Массив);

	// Diagnostic note — visible in Form Explorer notes panel (must be plain strings)
	КолТаблиц    = 0;
	КолПолей     = 0;
	КолГрупп     = 0;
	Для Каждого ДиагЭл Из ПлоскиеЭлементы Цикл
		ВидДиаг = ДиагЭл["kind"];
		Если ВидДиаг = "Table"                 Тогда КолТаблиц  = КолТаблиц  + 1;
		ИначеЕсли СтрНайти(ВидДиаг, "Field") > 0 Тогда КолПолей  = КолПолей   + 1;
		ИначеЕсли ВидДиаг = "Group"            Тогда КолГрупп   = КолГрупп   + 1;
		КонецЕсли;
	КонецЦикла;
	ЖивыхНайдено_Диаг  = ?(ДиагИнфо.Свойство("живых"),    Строка(ДиагИнфо["живых"]),    "?");
	ЖивыхСоЗначен_Диаг = ?(ДиагИнфо.Свойство("соЗначен"), Строка(ДиагИнфо["соЗначен"]), "?");
	ТекстНоты = "[Bridge diag] total=" + ПлоскиеЭлементы.Количество()
		+ " fields=" + КолПолей + " tables=" + КолТаблиц + " groups=" + КолГрупп
		+ " liveFields=" + ЖивыхНайдено_Диаг + " withValue=" + ЖивыхСоЗначен_Диаг
		+ " form=" + ЗнчИмяФормы
		+ ?(ПустаяСтрока(ДиагИнфо.живогоОшибки), "", " | liveVal-err: " + ДиагИнфо.живогоОшибки);
	МассивНот = Новый Массив;
	МассивНот.Добавить(ТекстНоты);
	Снимок.Вставить("notes", МассивНот);

	Возврат Снимок;

КонецФункции

&НаКлиенте
Функция KOTFEBridge_НайтиФормуВОкне(Окно)
	Если Окно = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Форма = Окно.НайтиОбъект(Тип("ТестируемаяФорма"));
		Если Форма <> Неопределено Тогда
			Возврат Форма;
		КонецЕсли;
	Исключение
	КонецПопытки;

	ФормыОкна = KOTFEBridge_ПолучитьФормыИзКонтейнера(Окно);
	Возврат KOTFEBridge_ВыбратьЛучшуюФорму(ФормыОкна, Окно);
КонецФункции

&НаКлиенте
Функция KOTFEBridge_НайтиФормуВПриложении(ТестПриложение, Окно = Неопределено)
	Если ТестПриложение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	ФормыПриложения = KOTFEBridge_ПолучитьФормыИзКонтейнера(ТестПриложение);
	Возврат KOTFEBridge_ВыбратьЛучшуюФорму(ФормыПриложения, Окно);
КонецФункции

&НаКлиенте
Функция KOTFEBridge_ПолучитьФормыИзКонтейнера(Контейнер)
	Результат = Новый Массив;
	Если Контейнер = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Попытка
		НайденныеФормы = Контейнер.НайтиОбъекты(Тип("ТестируемаяФорма"));
		Если НайденныеФормы <> Неопределено Тогда
			Для Каждого НайденнаяФорма Из НайденныеФормы Цикл
				Если НайденнаяФорма <> Неопределено Тогда
					Результат.Добавить(НайденнаяФорма);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	Исключение
	КонецПопытки;

	Возврат Результат;
КонецФункции

&НаКлиенте
Функция KOTFEBridge_ВыбратьЛучшуюФорму(Формы, Окно = Неопределено)
	Если Формы = Неопределено Или Формы.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Для Каждого КандидатФормы Из Формы Цикл
		Попытка
			ТекущийЭлемент = КандидатФормы.ПолучитьТекущийЭлемент();
			Если ТекущийЭлемент <> Неопределено Тогда
				Возврат КандидатФормы;
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЦикла;

	ЗаголовокОкна = "";
	Если Окно <> Неопределено Тогда
		Попытка ЗаголовокОкна = НРег(СокрЛП(Строка(Окно.Заголовок))); Исключение КонецПопытки;
	КонецЕсли;
	Если НЕ ПустаяСтрока(ЗаголовокОкна) Тогда
		Для Каждого КандидатФормы Из Формы Цикл
			ЗаголовокФормы = "";
			Попытка ЗаголовокФормы = НРег(СокрЛП(Строка(КандидатФормы.ТекстЗаголовка))); Исключение КонецПопытки;
			Если НЕ ПустаяСтрока(ЗаголовокФормы)
				И (СтрНайти(ЗаголовокОкна, ЗаголовокФормы) > 0 Или СтрНайти(ЗаголовокФормы, ЗаголовокОкна) > 0) Тогда
				Возврат КандидатФормы;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Возврат Формы[Формы.ВГраница()];
КонецФункции

&НаКлиенте
Функция KOTFEBridge_ПолучитьСостояниеМостаПоУмолчанию()
	Возврат Новый Структура(
		"hadTestClientConnection,connectionFailureCount,selfShutdownRequested,locatorActive,locatorBaseSignature",
		Ложь,
		0,
		Ложь,
		Ложь,
		""
	);
КонецФункции

&НаКлиенте
Функция KOTFEBridge_ПолучитьПутьФайлаСостоянияМоста()
	ПутьСтатуса = СокрЛП(Строка(KOTFEBridge_StatusFilePath));
	Если ПустаяСтрока(ПутьСтатуса) Тогда
		Возврат "bridge-runtime-state.json";
	КонецЕсли;

	НормПуть = СтрЗаменить(ПутьСтатуса, "\", "/");
	ЧастиПути = СтрРазделить(НормПуть, "/");
	Если ЧастиПути = Неопределено Или ЧастиПути.Количество() = 0 Тогда
		Возврат "bridge-runtime-state.json";
	КонецЕсли;

	ЧастиПути.Удалить(ЧастиПути.ВГраница());
	Каталог = СтрСоединить(ЧастиПути, "/");
	Если ПустаяСтрока(Каталог) Тогда
		Возврат "bridge-runtime-state.json";
	КонецЕсли;

	Возврат Каталог + "/bridge-runtime-state.json";
КонецФункции

&НаКлиенте
Функция KOTFEBridge_ПрочитатьСостояниеМоста()
	СостояниеМоста = KOTFEBridge_ПолучитьСостояниеМостаПоУмолчанию();
	ПутьСостояния = KOTFEBridge_ПолучитьПутьФайлаСостоянияМоста();
	Если ПустаяСтрока(ПутьСостояния) Тогда
		Возврат СостояниеМоста;
	КонецЕсли;

	Попытка
		ФайлСостояния = Новый Файл(ПутьСостояния);
		Если НЕ ФайлСостояния.Существует() Тогда
			Возврат СостояниеМоста;
		КонецЕсли;
	Исключение
		Возврат СостояниеМоста;
	КонецПопытки;

	Попытка
		Чтение = Новый ЧтениеJSON;
		Чтение.ОткрытьФайл(ПутьСостояния);
		ПрочитанноеСостояние = ПрочитатьJSON(Чтение);
		Чтение.Закрыть();
		Если ПрочитанноеСостояние <> Неопределено Тогда
			Попытка СостояниеМоста.hadTestClientConnection = ПрочитанноеСостояние.hadTestClientConnection = Истина; Исключение КонецПопытки;
			Попытка СостояниеМоста.connectionFailureCount = ПрочитанноеСостояние.connectionFailureCount; Исключение КонецПопытки;
			Попытка СостояниеМоста.selfShutdownRequested = ПрочитанноеСостояние.selfShutdownRequested = Истина; Исключение КонецПопытки;
			Попытка СостояниеМоста.locatorActive = ПрочитанноеСостояние.locatorActive = Истина; Исключение КонецПопытки;
			Попытка СостояниеМоста.locatorBaseSignature = СокрЛП(Строка(ПрочитанноеСостояние.locatorBaseSignature)); Исключение КонецПопытки;
		КонецЕсли;
	Исключение
	КонецПопытки;

	Если СостояниеМоста.connectionFailureCount < 0 Тогда
		СостояниеМоста.connectionFailureCount = 0;
	КонецЕсли;

	Возврат СостояниеМоста;
КонецФункции

&НаКлиенте
Функция KOTFEBridge_ПостроитьБыструюСигнатуруСнимка(Снимок)
	Если Снимок = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	ОписаниеФормы = Неопределено;
	Попытка ОписаниеФормы = Снимок["form"]; Исключение КонецПопытки;
	Если ОписаниеФормы = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	ПутьАктивного = "";
	ЗаголовокОкна = "";
	ПутьМетаданных = "";
	Попытка ПутьАктивного = СокрЛП(Строка(ОписаниеФормы["activeElementPath"])); Исключение КонецПопытки;
	Попытка ЗаголовокОкна = СокрЛП(Строка(ОписаниеФормы["windowTitle"])); Исключение КонецПопытки;
	Попытка ПутьМетаданных = СокрЛП(Строка(ОписаниеФормы["metadataPath"])); Исключение КонецПопытки;

	ЗначениеАктивного = "";
	Если НЕ ПустаяСтрока(ПутьАктивного) Тогда
		ЭлементыСнимка = Неопределено;
		Попытка ЭлементыСнимка = Снимок["elements"]; Исключение КонецПопытки;
		АктивныйЭлемент = KOTFEBridge_НайтиЭлементВСнимкеПоПути(ЭлементыСнимка, ПутьАктивного);
		Если АктивныйЭлемент <> Неопределено Тогда
			Попытка ЗначениеАктивного = СокрЛП(Строка(АктивныйЭлемент["valuePreview"])); Исключение КонецПопытки;
		КонецЕсли;
	КонецЕсли;

	Возврат ПутьМетаданных
		+ "|" + ЗаголовокОкна
		+ "|" + ПутьАктивного
		+ "|" + ЗначениеАктивного;
КонецФункции

&НаКлиенте
Функция KOTFEBridge_НайтиЭлементВСнимкеПоПути(Элементы, ПутьЭлемента)
	Если Элементы = Неопределено Или ПустаяСтрока(ПутьЭлемента) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Для Каждого Элемент Из Элементы Цикл
		КандидатПуть = "";
		Попытка КандидатПуть = СокрЛП(Строка(Элемент["path"])); Исключение КонецПопытки;
		Если КандидатПуть = ПутьЭлемента Тогда
			Возврат Элемент;
		КонецЕсли;

		ДочерниеЭлементы = Неопределено;
		Попытка ДочерниеЭлементы = Элемент["children"]; Исключение КонецПопытки;
		НайденныйЭлемент = KOTFEBridge_НайтиЭлементВСнимкеПоПути(ДочерниеЭлементы, ПутьЭлемента);
		Если НайденныйЭлемент <> Неопределено Тогда
			Возврат НайденныйЭлемент;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;
КонецФункции

&НаКлиенте
Процедура KOTFEBridge_ЗаписатьСостояниеМоста(СостояниеМоста)
	ПутьСостояния = KOTFEBridge_ПолучитьПутьФайлаСостоянияМоста();
	Если ПустаяСтрока(ПутьСостояния) Тогда
		Возврат;
	КонецЕсли;

	ИмяВрем = ПолучитьИмяВременногоФайла("json");
	Попытка
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.ОткрытьФайл(ИмяВрем);
		ЗаписатьJSON(ЗаписьJSON, СостояниеМоста);
		ЗаписьJSON.Закрыть();
		КопироватьФайл(ИмяВрем, ПутьСостояния);
	Исключение
	КонецПопытки;
	Попытка УдалитьФайлы(ИмяВрем); Исключение КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура KOTFEBridge_ЗафиксироватьУспешнуюСвязьСТестКлиентом(СостояниеМоста)
	СостояниеМоста.hadTestClientConnection = Истина;
	СостояниеМоста.connectionFailureCount = 0;
	СостояниеМоста.selfShutdownRequested = Ложь;
	KOTFEBridge_ЗаписатьСостояниеМоста(СостояниеМоста);
КонецПроцедуры

&НаКлиенте
Функция KOTFEBridge_НужноПроверитьСвязьСТестКлиентом(СостояниеМоста, ЕстьЗапрос, АвтоОбновление)
	Если ЕстьЗапрос Или АвтоОбновление Тогда
		Возврат Ложь;
	КонецЕсли;

	Если НЕ СостояниеМоста.hadTestClientConnection Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат Истина;
КонецФункции

&НаКлиенте
Функция KOTFEBridge_ЭтоОшибкаПотериTestClient(ТекстОшибки)
	НормТекстОшибки = НРег(СокрЛП(Строка(ТекстОшибки)));
	Если ПустаяСтрока(НормТекстОшибки) Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат СтрНайти(НормТекстОшибки, "connection refused") > 0
		Или СтрНайти(НормТекстОшибки, "actively refused") > 0
		Или СтрНайти(НормТекстОшибки, "forcibly closed") > 0
		Или СтрНайти(НормТекстОшибки, "target machine") > 0
		Или СтрНайти(НормТекстОшибки, "transport connection") > 0
		Или СтрНайти(НормТекстОшибки, "не удалось установить соединение") > 0
		Или СтрНайти(НормТекстОшибки, "соединение не установлено") > 0
		Или СтрНайти(НормТекстОшибки, "принудительно разорвал") > 0
		Или СтрНайти(НормТекстОшибки, "удаленный хост") > 0
		Или СтрНайти(НормТекстОшибки, "соединение разорвано") > 0
		Или СтрНайти(НормТекстОшибки, "connection reset") > 0;
КонецФункции

&НаКлиенте
Функция KOTFEBridge_ОбработатьПотерюСвязиСТестКлиентом(СостояниеМоста, ТекстОшибки)
	Если НЕ СостояниеМоста.hadTestClientConnection Тогда
		Возврат Ложь;
	КонецЕсли;

	СостояниеМоста.connectionFailureCount = СостояниеМоста.connectionFailureCount + 1;
	KOTFEBridge_ЗаписатьСостояниеМоста(СостояниеМоста);
	KOTFEBridge_ЗаписатьСтатус(
		"test-client-lost:"
		+ Строка(СостояниеМоста.connectionFailureCount)
		+ ":"
		+ Лев(СокрЛП(Строка(ТекстОшибки)), 120)
	);

	Если СостояниеМоста.connectionFailureCount < 3 Тогда
		Возврат Ложь;
	КонецЕсли;

	KOTFEBridge_ЗапроситьСамозавершение("test-client-lost", СостояниеМоста);
	Возврат Истина;
КонецФункции

&НаКлиенте
Процедура KOTFEBridge_ЗапроситьСамозавершение(Причина = "", СостояниеМоста = Неопределено)
	Если СостояниеМоста = Неопределено Тогда
		СостояниеМоста = KOTFEBridge_ПрочитатьСостояниеМоста();
	КонецЕсли;

	Если СостояниеМоста.selfShutdownRequested Тогда
		Возврат;
	КонецЕсли;

	СостояниеМоста.selfShutdownRequested = Истина;
	KOTFEBridge_ЗаписатьСостояниеМоста(СостояниеМоста);
	KOTFEBridge_ЗаписатьСтатус("closing:" + СокрЛП(Строка(Причина)));
	Попытка
		ОтключитьОбработчикОжидания("KOTFEBridge_ЦиклОпроса");
	Исключение
	КонецПопытки;

	Попытка
		Закрыть();
	Исключение
	КонецПопытки;

	Попытка
		Выполнить("ЗавершитьРаботуСистемы()");
	Исключение
	КонецПопытки;
КонецПроцедуры

